HOST=127.0.0.1
PORT=8080
PUBLIC_URL=https://devcom.example.com
DATA_FILE=./data/devcom.json

ADMIN_USERNAME=admin
# Generate with: node -e "import('bcryptjs').then(({hashSync}) => console.log(hashSync('change-me', 12)))"
ADMIN_PASSWORD_HASH=
# A long random value used by agents and automations.
AGENT_API_TOKEN=
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Apple Push Notification provider credentials.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.maximkabaev.devcom
# The Compose setup mounts ./secrets at /run/secrets read-only.
APNS_PRIVATE_KEY=/run/secrets/AuthKey.p8
